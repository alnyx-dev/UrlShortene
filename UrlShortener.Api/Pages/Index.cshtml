@page
@model UrlShortener.Api.Pages.IndexModel
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>URL Shortener</title>
    <style>
        body {
            font-family: -apple-system, Segoe UI, sans-serif;
            background: #f5f5f7;
            display: flex;
            justify-content: center;
            padding-top: 80px;
        }
        .card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 32px;
            width: 480px;
        }
        h1 { font-size: 22px; margin-bottom: 24px; }
        input[type=text] {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
        }
        button {
            margin-top: 12px;
            width: 100%;
            padding: 12px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
        }
        button:hover { background: #1d4ed8; }
        .result {
            margin-top: 20px;
            padding: 16px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            word-break: break-all;
        }
        .error {
            margin-top: 20px;
            padding: 16px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: #b91c1c;
        }
        a { color: #2563eb; font-weight: 600; }
    </style>
</head>
<body>
    <div class="card">
        <h1>🔗 URL Shortener</h1>
        <form method="post" asp-page="/Index">
            <input type="text" asp-for="OriginalUrl" placeholder="https://example.com/very/long/link" />
            <button type="submit">Сократить</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.GeneratedShortUrl))
        {
            <div class="result">
                Готово: <a href="@Model.GeneratedShortUrl" target="_blank">@Model.GeneratedShortUrl</a>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error">@Model.ErrorMessage</div>
        }
    </div>
</body>
</html>