@page
@model UrlShortener.Api.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="card">
    <h1>Вход</h1>
    <form method="post" asp-page="/Login">
        <input type="hidden" asp-for="ReturnUrl" />
        <label class="label">Email</label>
        <input type="email" asp-for="Email" placeholder="you@example.com" required />
        <label class="label">Пароль</label>
        <input type="password" asp-for="Password" placeholder="Ваш пароль" required />
        <button type="submit">Войти</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }
    <p style="margin-top:16px;font-size:14px;text-align:center;">
        Нет аккаунта? <a href="/Register">Зарегистрироваться</a>
    </p>
</div>
