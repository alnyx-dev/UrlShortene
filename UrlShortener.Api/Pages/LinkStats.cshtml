@page "{code}"
@model UrlShortener.Api.Pages.LinkStatsModel
@{
    ViewData["Title"] = $"Статистика — {Model.Code}";
    Layout = "/Pages/Shared/_Layout.cshtml";

    var prevMonth = Model.CurrentMonth == 1 ? 12 : Model.CurrentMonth - 1;
    var prevYear = Model.CurrentMonth == 1 ? Model.CurrentYear - 1 : Model.CurrentYear;
    var nextMonth = Model.CurrentMonth == 12 ? 1 : Model.CurrentMonth + 1;
    var nextYear = Model.CurrentMonth == 12 ? Model.CurrentYear + 1 : Model.CurrentYear;
}
<div class="card" style="max-width:720px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h1 style="margin:0;">Статистика</h1>
        <a href="/MyLinks" style="font-size:14px;">← Мои ссылки</a>
    </div>

    <div style="margin-bottom:16px;">
        <span style="font-size:14px;color:#6b7280;">Код:</span>
        <strong>@Model.Stats!.ShortCode</strong>
        <span style="margin-left:12px;font-size:14px;color:#6b7280;">URL:</span>
        <a href="@Model.Stats.OriginalUrl" target="_blank" style="font-size:14px;">@Model.Stats.OriginalUrl</a>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;padding:12px;background:#f9fafb;border-radius:8px;">
        <a href="?code=@Model.Code&month=@prevMonth&year=@prevYear" style="color:#2563eb;">← @Model.MonthName() @(prevYear)</a>
        <strong>@Model.MonthName() @Model.CurrentYear</strong>
        <a href="?code=@Model.Code&month=@nextMonth&year=@nextYear" style="color:#2563eb;">@Model.MonthName() @(nextYear) →</a>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;margin-bottom:24px;">
        <div style="text-align:center;padding:16px;background:#f0fdf4;border-radius:8px;">
            <div style="font-size:28px;font-weight:700;color:#16a34a;">@Model.Stats.TotalClicks</div>
            <div style="font-size:12px;color:#6b7280;">Кликов</div>
        </div>
        <div style="text-align:center;padding:16px;background:#eff6ff;border-radius:8px;">
            <div style="font-size:28px;font-weight:700;color:#2563eb;">@Model.Stats.ByDevice.Count</div>
            <div style="font-size:12px;color:#6b7280;">Устройств</div>
        </div>
        <div style="text-align:center;padding:16px;background:#fef3c7;border-radius:8px;">
            <div style="font-size:28px;font-weight:700;color:#d97706;">@Model.Stats.ByReferrer.Count</div>
            <div style="font-size:12px;color:#6b7280;">Рефереров</div>
        </div>
        <div style="text-align:center;padding:16px;background:#fce7f3;border-radius:8px;">
            <div style="font-size:28px;font-weight:700;color:#db2777;">@Model.Stats.ByCountry.Count</div>
            <div style="font-size:12px;color:#6b7280;">Стран</div>
        </div>
    </div>

    @if (Model.Stats.ClicksByDay.Count > 0)
    {
        <h2 style="font-size:16px;margin-bottom:12px;">Клики по дням</h2>
        <div id="chart" style="height:200px;border:1px solid #e5e5e5;border-radius:8px;margin-bottom:24px;position:relative;overflow:hidden;">
            @{
                var maxClicks = Model.Stats.ClicksByDay.Max(d => d.Count);
                var barWidth = 100.0 / Model.Stats.ClicksByDay.Count;
            }
            <div style="display:flex;align-items:flex-end;height:100%;padding:8px;">
                @foreach (var day in Model.Stats.ClicksByDay)
                {
                    var height = maxClicks > 0 ? (day.Count * 100.0 / maxClicks) : 0;
                    <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;padding:0 1px;">
                        <div style="font-size:10px;color:#6b7280;margin-bottom:2px;">@day.Count</div>
                        <div style="width:100%;background:#2563eb;border-radius:3px 3px 0 0;height:@(height)%;" title="@day.Date.ToString("dd.MM") — @day.Count кликов"></div>
                        <div style="font-size:9px;color:#9ca3af;margin-top:4px;writing-mode:vertical-rl;text-orientation:mixed;height:40px;">@day.Date.ToString("dd")</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Stats.ByDevice.Count > 0)
    {
        <h2 style="font-size:16px;margin-bottom:12px;">По устройствам</h2>
        <table>
            <thead>
                <tr><th>Устройство</th><th>Клики</th><th>Доля</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Stats.ByDevice)
                {
                    var pct = Model.Stats.TotalClicks > 0 ? (d.Count * 100.0 / Model.Stats.TotalClicks) : 0;
                    <tr>
                        <td>@d.DeviceType</td>
                        <td>@d.Count</td>
                        <td>@pct.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Stats.ByReferrer.Count > 0)
    {
        <h2 style="font-size:16px;margin-top:24px;margin-bottom:12px;">По реферерам</h2>
        <table>
            <thead>
                <tr><th>Реферер</th><th>Клики</th><th>Доля</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Stats.ByReferrer)
                {
                    var pct = Model.Stats.TotalClicks > 0 ? (r.Count * 100.0 / Model.Stats.TotalClicks) : 0;
                    <tr>
                        <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(r.Referrer ?? "Прямой переход")</td>
                        <td>@r.Count</td>
                        <td>@pct.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Stats.ByCountry.Count > 0)
    {
        <h2 style="font-size:16px;margin-top:24px;margin-bottom:12px;">По странам</h2>
        <table>
            <thead>
                <tr><th>Страна</th><th>Клики</th><th>Доля</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Stats.ByCountry)
                {
                    var pct = Model.Stats.TotalClicks > 0 ? (c.Count * 100.0 / Model.Stats.TotalClicks) : 0;
                    <tr>
                        <td>@c.Country</td>
                        <td>@c.Count</td>
                        <td>@pct.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Stats.ClicksByDay.Count == 0)
    {
        <div class="empty">Нет данных за этот месяц</div>
    }
</div>
